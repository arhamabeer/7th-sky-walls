# Normalize line endings: LF in the repository, native in working copies.
# Keeps diffs clean between Windows development and Linux deployment.
* text=auto eol=lf

# Binary assets — never touch these.
*.png binary
*.jpg binary
*.jpeg binary
*.webp binary
*.avif binary
*.ico binary
*.woff binary
*.woff2 binary
*.glb binary
*.usdz binary
